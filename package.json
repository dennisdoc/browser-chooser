{
  "name": "url-router",
  "version": "0.0.1",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:routing": "node --test electron/url-matcher.test.js",
    "serve:ssr:url-router": "node dist/url-router/server/server.mjs",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && cross-env NG_DEV=1 electron .\"",
    "electron": "ng build --base-href ./ && electron .",
    "dist": "ng build --base-href ./ && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.dennis.urlrouter",
    "productName": "URL Router",
    "files": [
      "electron/**",
      "dist/url-router/browser/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  }
}
